# === Zero-Budget LLM Configuration ===
# Get a 100% free Gemini API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# === Web Search Provider Options ===
# Choose between: "tavily" (1000 free searches/mo), "puter" (free Perplexity Sonar), or "perplexity" (paid)
WEB_SEARCH_PROVIDER=tavily

# Option 1: Tavily (Recommended for Free Tier - 1,000 free searches/mo at https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
TAVILY_CHUNKS_PER_SOURCE=3

# Option 2: Puter AI (Free Perplexity Sonar - get free token at https://puter.com/dashboard)
PUTER_AUTH_TOKEN=your_puter_auth_token_here
PUTER_MODEL=perplexity/sonar

# Option 3: Direct Perplexity (Paid - only if you have paid Perplexity API key)
PPLX_API_KEY=your_perplexity_api_key_here

# === Web Scraping ===
# Firecrawl Free Tier (~500 free scrapes) at https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# === Optional Keys ===
# GitHub personal access token (free at https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# Opik Telemetry (optional - leave blank if not using)
OPIK_API_KEY=